vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

direction: right

classes: {
  entry: {
    shape: rectangle
    style: {
      fill: "#A5D8FF"
      stroke: "#1E1E1E"
      stroke-width: 1
      border-radius: 6
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  process: {
    shape: rectangle
    style: {
      fill: "#FFEC99"
      stroke: "#1E1E1E"
      stroke-width: 1
      border-radius: 6
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  data: {
    shape: rectangle
    style: {
      fill: "#B2F2BB"
      stroke: "#1E1E1E"
      stroke-width: 1
      border-radius: 6
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FFC9C9"
      stroke: "#1E1E1E"
      stroke-width: 1
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  human: {
    shape: rectangle
    style: {
      fill: "#D0BFFF"
      stroke: "#1E1E1E"
      stroke-width: 1
      border-radius: 6
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  background: {
    shape: rectangle
    style: {
      fill: "#F1F3F5"
      stroke: "#1E1E1E"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 0
      font-color: "#1E1E1E"
      font-size: 13
    }
  }
  note: {
    shape: rectangle
    style: {
      fill: "#F1F3F5"
      stroke: "#868E96"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 0
      font-color: "#495057"
      font-size: 12
    }
  }
  group: {
    style: {
      fill: transparent
      stroke: "#ADB5BD"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 6
      font-color: "#495057"
      font-size: 12
    }
  }

  flow: {
    style: {stroke: "#1E1E1E"; stroke-width: 1; font-color: "#343A40"; font-size: 11; italic: false}
  }
  secondary: {
    style: {stroke: "#1E1E1E"; stroke-width: 1; stroke-dash: 4; font-color: "#343A40"; font-size: 11; italic: false}
  }
}
