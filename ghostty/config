auto-update = download

shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Plain Iosevka with Ghostty's built-in Nerd Font icons; the Nerd Font is only a fallback while Iosevka is not installed
font-family = "Iosevka"
font-size = 16
font-thicken = true
adjust-underline-thickness = 3
adjust-underline-position = 4

confirm-close-surface = false
copy-on-select = clipboard
cursor-style-blink = false
macos-option-as-alt = left
quit-after-last-window-closed = true
window-padding-x = 15
window-padding-y = 10,2
quick-terminal-position = center
quick-terminal-size = 80%,80%
drag-handle = always
unfocused-split-opacity = 0.85
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify

# Gruber Darker colours from gruber-darker.nvim, written out because Ghostty's bundled theme uses different values
background = #181818
foreground = #E4E4E4
cursor-color = #FFDD33
cursor-text = #181818
selection-background = #453D41
selection-foreground = #F4F4FF
palette = 0=#181818
palette = 1=#F43841
palette = 2=#73D936
palette = 3=#FFDD33
palette = 4=#96A6C8
palette = 5=#9E95C7
palette = 6=#95A99F
palette = 7=#F5F5F5
palette = 8=#52494E
palette = 9=#F43841
palette = 10=#73D936
palette = 11=#FFDD33
palette = 12=#96A6C8
palette = 13=#9E95C7
palette = 14=#95A99F
palette = 15=#FFFFFF

# Cmd shortcuts drive Ghostty; while Neovim runs, its nvim table sends Cmd-h/j/k/l as Alt-h/t/c/n (esc:<key>)
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

keybind = nvim/cmd+h=esc:h
keybind = nvim/cmd+j=esc:t
keybind = nvim/cmd+k=esc:c
keybind = nvim/cmd+l=esc:n

keybind = alt+shift+left=resize_split:left,40
keybind = alt+shift+down=resize_split:down,60
keybind = alt+shift+up=resize_split:up,60
keybind = alt+shift+right=resize_split:right,40

keybind = cmd+d=new_split:right
keybind = chain=equalize_splits
keybind = cmd+shift+d=new_split:down
keybind = chain=equalize_splits
keybind = cmd+f=toggle_quick_terminal
keybind = cmd+backquote=goto_window:next
keybind = cmd+shift+backquote=goto_window:previous
keybind = cmd+shift+,=move_tab:-1
keybind = cmd+shift+.=move_tab:1
keybind = cmd+r=reload_config
keybind = cmd+/=start_search
